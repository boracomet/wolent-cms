# ─── Build Stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/utils/package.json ./packages/utils/
COPY packages/database/package.json ./packages/database/
COPY packages/core/package.json ./packages/core/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/utils ./packages/utils
COPY packages/database ./packages/database
COPY packages/core ./packages/core

# Build
RUN pnpm --filter @wolent/utils build
RUN pnpm --filter @wolent/database build
RUN pnpm --filter @wolent/core build

# Generate Prisma client
RUN cd packages/database && npx prisma generate

# ─── Production Stage ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 wolent && \
    adduser --system --uid 1001 wolent

# Copy built artifacts
COPY --from=builder /app/packages/core/dist ./dist
COPY --from=builder /app/packages/database/prisma ./prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

COPY packages/core/package.json ./

# Create upload directory
RUN mkdir -p /app/public/uploads && chown -R wolent:wolent /app

USER wolent

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["node", "dist/index.js"]
