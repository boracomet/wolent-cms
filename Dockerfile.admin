# ─── Build Stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.base.json ./
COPY packages/admin/package.json ./packages/admin/
COPY packages/utils/package.json ./packages/utils/

RUN pnpm install --frozen-lockfile

COPY packages/utils ./packages/utils
COPY packages/admin ./packages/admin

RUN pnpm --filter @wolent/utils build
RUN pnpm --filter @wolent/admin build

# ─── Serve Stage ─────────────────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/packages/admin/dist /usr/share/nginx/html
COPY packages/create-wolent-app/templates/base/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
