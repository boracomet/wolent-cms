{
  "name": "@wolent/core",
  "version": "0.1.0",
  "description": "Wolent CMS — headless CMS core (Fastify + Prisma + Auth + RBAC + Content Engine)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate-keys": "tsx src/scripts/generate-keys.ts",
    "setup": "tsx src/setup.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^5.22.0",
    "@wolent/utils": "workspace:*",
    "argon2": "^0.41.0",
    "awilix": "^12.0.0",
    "dotenv": "^16.4.5",
    "fast-jwt": "^6.1.0",
    "fastify": "^5.2.0",
    "find-up": "^8.0.0",
    "ms": "^2.1.3",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.4.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "redis": "^5.11.0",
    "sanitize-html": "^2.13.0",
    "slugify": "^1.6.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/nodemailer": "^6.4.23",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.13.0",
    "@types/sharp": "^0.32.0",
    "prisma": "^5.22.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  }
}
