{
  "name": "create-wolent-app",
  "version": "0.1.0",
  "description": "Create a new Wolent CMS project with one command",
  "type": "module",
  "bin": {
    "create-wolent-app": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "prompts": "^2.4.2",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "fs-extra": "^11.2.0",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.3",
    "open": "^10.1.0",
    "gradient-string": "^2.0.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "@types/fs-extra": "^11.0.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/gradient-string": "^1.1.4",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
