# Wolent CMS — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production)
# DATABASE_URL="postgresql://wolent:your_password@localhost:5432/wolent_cms?schema=public"

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate real RSA keys for production:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -i private.pem | tr -d '\n'  → JWT_PRIVATE_KEY
#   base64 -i public.pem | tr -d '\n'   → JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Secrets (min 32 chars) ───────────────────────────────────────────────────
COOKIE_SECRET=""
ADMIN_JWT_SECRET=""

# ─── CORS (comma-separated) ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:1337

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ─── Media Storage ────────────────────────────────────────────────────────────
UPLOAD_PROVIDER=local
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE=10485760

# S3 (if UPLOAD_PROVIDER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=        # for S3-compatible providers (Cloudflare R2, MinIO, etc.)

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Initial Admin (used on first run) ────────────────────────────────────────
WOLENT_ADMIN_EMAIL=admin@example.com
WOLENT_ADMIN_PASSWORD=

# ─── PostgreSQL (Docker Compose) ──────────────────────────────────────────────
POSTGRES_PASSWORD=wolent
